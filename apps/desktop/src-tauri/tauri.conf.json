{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ColorBalance Light-Table",
  "version": "0.1.1",
  "identifier": "com.colorbalance.lighttable",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ColorBalance // Light-Table OS",
        "width": 1480,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Benjamin Kleinert",
    "copyright": "Copyright (c) 2026 Benjamin Kleinert. MIT License.",
    "shortDescription": "Measured ColorChecker color calibration",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../../../LICENSE": "licenses/LICENSE",
      "../../../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../../../third_party/licenses/*": "licenses/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
